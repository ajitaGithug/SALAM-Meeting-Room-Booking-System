# No folder listings (e.g. /sql/, /assets/)
Options -Indexes

# Hide git data, the SQL dump and project docs from the browser
RedirectMatch 404 /\.git
RedirectMatch 404 /sql/
<FilesMatch "^(README\.md|config\.example\.php|helpers\.php|session_check\.php|header\.php|\.gitignore|\.htaccess)$">
    Require all denied
</FilesMatch>

# Basic security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>
